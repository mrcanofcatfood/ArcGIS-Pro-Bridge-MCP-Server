  </AddInInfo>
  <modules>
    <insertModule id="APBridgeAddIn_Module" className="Module1" autoLoad="true" caption="ArcGIS Pro Bridge">
      <tabs>
        <tab id="APBridgeAddIn_Tab1" caption="ArcGIS Bridge">
          <group refID="APBridgeAddIn_Group1"/>
